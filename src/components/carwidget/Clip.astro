---
// A muted, looping clip. The poster is a real <picture> (so it can be the LCP element and
// never shifts layout); the video only gets its sources once it nears the viewport, and
// stays still for people who prefer reduced motion. Driven by the script in CarWidgetPage.
import media from '../../data/carwidget-media.json';

interface Props { name: string; label: string; eager?: boolean; toggle?: boolean; class?: string }
const { name, label, eager = false, toggle = true, class: className } = Astro.props;
const info = (media.videos as Record<string, { width: number; height: number; webm?: number; poster: { width: number; height: number } }>)[name];
if (!info) throw new Error(`Unknown CarWidget video: ${name}`);
const base = `/assets/apps/carwidget/${name}`;
---
<div class:list={['clip', className]} style={`aspect-ratio:${info.width} / ${info.height}`}>
  <picture>
    <source type="image/avif" srcset={`${base}-poster.avif`} />
    <source type="image/webp" srcset={`${base}-poster.webp`} />
    <img
      src={`${base}-poster.jpg`}
      width={info.poster.width}
      height={info.poster.height}
      alt={label}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding={eager ? 'sync' : 'async'}
    />
  </picture>
  <video data-clip muted loop playsinline preload="none" width={info.width} height={info.height} aria-hidden="true" tabindex="-1" disablepictureinpicture>
    {info.webm && <source data-src={`${base}.webm`} type="video/webm" />}
    <source data-src={`${base}.mp4`} type="video/mp4" />
  </video>
  {toggle && <button class="clip-toggle" type="button" hidden aria-label="Pause video" data-pause="Pause video" data-play="Play video"><span aria-hidden="true"></span></button>}
</div>
