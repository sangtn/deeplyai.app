---
interface Props {
  href?: string;
  lang?: 'en' | 'vi';
  tone?: 'black' | 'white';
}
const DEVELOPER_PAGE = 'https://apps.apple.com/us/developer/deeply-ai/id1809787876?itscg=30200&itsct=apps_box_badge&mttnsubad=1809787876';
const { href = DEVELOPER_PAGE, lang = 'en', tone = 'black' } = Astro.props;
const locale = lang === 'vi' ? 'vi-vn' : 'en-us';
const alt = lang === 'vi' ? 'Tải về trên App Store' : 'Download on the App Store';
---
<a class="store-badge" href={href} rel="noopener">
  <img src={`/assets/images/stores/app-store-${tone}-${locale}.svg`} width="150" height="50" alt={alt} />
</a>
