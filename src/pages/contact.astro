---
import Base from '../layouts/Base.astro';
---
<Base path="/contact.html" title="Contact DeeplyAi – Support & App Enquiries" description="Contact DeeplyAi for app support, feature requests or partnership enquiries. Email info@deeplyai.app and we will get back to you.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Contact</p>
      <h1 class="display">Get in touch.</h1>
      <p class="lead">Suggest a feature, report an issue, or tell us about a project. We are here to answer any question you may have.</p>
    </header>
    <section class="section split" style="padding-top:24px">
      <div>
        <dl class="contact-list">
          <div><dt>Email</dt><dd><a href="mailto:info@deeplyai.app">info@deeplyai.app</a></dd></div>
          <div><dt>Phone</dt><dd><a href="tel:+840352053998">+84 035 2053 998</a></dd></div>
          <div><dt>Office</dt><dd>Mai Dich, Ha Noi, Vietnam</dd></div>
        </dl>
      </div>
      <form class="form" action="mailto:info@deeplyai.app" method="post" enctype="text/plain" data-contact>
        <label>Your name<input name="name" autocomplete="name" required maxlength="200" /></label>
        <label>Email address<input name="email" type="email" autocomplete="email" required maxlength="200" /></label>
        <label>Topic<input name="topic" maxlength="200" /></label>
        <label>Message<textarea name="message" rows="6" required maxlength="2000"></textarea></label>
        <div class="actions"><button class="btn" type="submit" style="cursor:pointer">Open email to send</button></div>
        <p style="color:var(--ink-2);font-size:14px">This opens your email app with the message filled in. See our <a href="/privacy.html">Privacy Policy</a>.</p>
      </form>
    </section>
  </div>
</Base>

<script>
  document.querySelector<HTMLFormElement>('form[data-contact]')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(event.target as HTMLFormElement);
    const value = (key: string) => String(data.get(key) ?? '').trim();
    const body = [`Name: ${value('name')}`, `Email: ${value('email')}`, '', value('message')].join('\n');
    const subject = value('topic') || 'Website enquiry';
    window.location.href = `mailto:info@deeplyai.app?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
