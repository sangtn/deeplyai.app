---
// Marketing page for Lịch Việt (App Store id 6749473194): VI at /vi/apps/lich-van-nien/ (the
// app's main audience) and EN at /apps/lich-van-nien/. Copy in ./copy.ts, media from
// scripts/lich-viet-media.mjs, lunar maths in ./lunar.ts.
import '@fontsource/alegreya/700.css';
import '@fontsource/alegreya/400-italic.css';
import Base from '../../layouts/Base.astro';
import StoreBadge from '../StoreBadge.astro';
import AppCard from '../AppCard.astro';
import Pic from './Pic.astro';
import media from '../../data/lich-viet-media.json';
import { COPY, MONTHS_EN, type Lang } from './copy';
import { CHI, CHI_ICONS, LUNAR_MONTHS, dayInfo, vietnamToday } from './lunar';
import { byId, hasRating, inGroup } from '../../data/catalog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const vi = lang === 'vi';
const t = COPY[lang];

const ID = 6749473194;
const app = byId.get(ID)!;
const site = 'https://deeplyai.app';
const paths = { vi: '/vi/apps/lich-van-nien/', en: '/apps/lich-van-nien/' };
const path = paths[lang];
const showRating = hasRating(app);
const fill = (text: string, vars: Record<string, string | number>) => text.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));
const related = inGroup(app.group).filter((a) => a.id !== ID).slice(0, 3);
const shot = (i: number) => `store-${String(i + 1).padStart(2, '0')}`;
const alt = (i: number) => t.shots[i];

// The page ships with the build day; the script below swaps in the visitor's actual day.
const now = vietnamToday();
const info = dayInfo(now.day, now.month, now.year);
const lunarMonthName = (m: number, leap: boolean) => (vi ? LUNAR_MONTHS[m - 1] : `Month ${m}`) + (leap ? ` (${t.today.leap})` : '');
const solarMonth = vi ? fill(t.today.solarMonth, { m: now.month, y: now.year }) : fill(t.today.solarMonth, { month: MONTHS_EN[now.month - 1], y: now.year });
const tetLine = info.tet.days === 0 ? fill(t.today.tetToday, { name: info.tet.name }) : fill(t.today.tet, { n: info.tet.days, name: info.tet.name });
const zodiacYear = info.yearChi;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    '@id': `${site}/apps/lich-van-nien/#app`,
    name: vi ? 'Lịch Việt – Lịch Vạn Niên' : 'Lich Viet – Vietnamese Lunar Calendar',
    alternateName: ['Lịch Vạn Niên 2026 • Lịch Việt', 'Lịch Việt', 'Lich Van Nien'],
    description: t.description,
    url: `${site}${path}`,
    inLanguage: lang,
    image: `${site}${app.iconLarge}`,
    screenshot: media.shots.map((s) => `${site}/assets/apps/lich-viet/${s}-560.jpg`),
    operatingSystem: `iOS ${app.minimumOs} or later`,
    applicationCategory: 'LifestyleApplication',
    applicationSubCategory: vi ? 'Lịch âm' : 'Lunar calendar',
    availableOnDevice: 'iPhone, iPad, Apple Watch',
    softwareVersion: app.version,
    installUrl: app.url,
    downloadUrl: app.url,
    featureList: t.jumpLinks.slice(1, -1).map(([, label]) => label),
    author: { '@type': 'Organization', name: 'DeeplyAi', url: `${site}/` },
    publisher: { '@type': 'Organization', name: 'DeeplyAi', url: `${site}/` },
    offers: {
      '@type': 'Offer',
      price: 0,
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: app.url,
      description: t.free,
    },
    ...(showRating && { aggregateRating: { '@type': 'AggregateRating', ratingValue: app.rating, ratingCount: app.ratingCount, bestRating: 5, worstRating: 1 } }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: t.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: vi ? 'Trang chủ' : 'Home', item: `${site}${vi ? '/vi/' : '/'}` },
      { '@type': 'ListItem', position: 2, name: t.crumbs[0], item: `${site}${vi ? '/vi/apps/' : '/apps/'}` },
      { '@type': 'ListItem', position: 3, name: t.crumbs[1], item: `${site}${path}` },
    ],
  },
];
---
<Base
  lang={lang}
  path={path}
  alternates={{ en: paths.en, vi: paths.vi }}
  title={t.title}
  description={t.description}
  ogImage={`/assets/apps/lich-viet/og-${lang}.jpg`}
  ogImageAlt={t.ogAlt}
  jsonLd={jsonLd}
>
  <div class="lv" data-lang={lang}>
    <section class="lv-hero">
      <span class="lv-drum lv-drum-hero" aria-hidden="true"></span>
      <div class="wrap">
        <nav class="crumbs" aria-label={vi ? 'Đường dẫn' : 'Breadcrumb'}><a href={vi ? '/vi/apps/' : '/apps/'}>{t.crumbs[0]}</a><span>/</span><span>{t.crumbs[1]}</span></nav>
        <div class="lv-hero-grid">
          <div class="lv-hero-copy">
            <img class="lv-icon" src={app.iconLarge} width="112" height="112" alt={vi ? 'Biểu tượng ứng dụng Lịch Việt' : 'Lich Viet app icon'} />
            <p class="lv-eyebrow">{t.eyebrow}</p>
            <h1>{t.h1}<span class="lv-h1-sub">{t.h1Sub}</span></h1>
            <p class="lv-lead">{t.lead}</p>
            <div class="lv-actions">
              <StoreBadge href={app.url} lang={lang} tone="white" />
              <a class="lv-btn-ghost" href="#hom-nay">{t.todayCta}</a>
            </div>
            <p class="lv-meta">
              <span class="lv-new">{t.newIn}</span>
              <span>{t.free}</span>
              {showRating && <span>{fill(t.ratingLine, { r: vi ? app.rating.toFixed(1).replace('.', ',') : app.rating.toFixed(1), n: app.ratingCount })}</span>}
              <span>{fill(t.requires, { v: app.minimumOs })}</span>
            </p>
          </div>
          <div class="lv-hero-media">
            <div class="lv-stack">
              <Pic class="lv-shot lv-stack-l" name={shot(1)} alt={alt(1)} sizes="(max-width: 900px) 40vw, 230px" />
              <Pic class="lv-shot lv-stack-r" name={shot(8)} alt={alt(8)} sizes="(max-width: 900px) 40vw, 230px" />
              <Pic class="lv-shot lv-stack-c" name={shot(0)} alt={alt(0)} sizes="(max-width: 900px) 56vw, 300px" eager />
            </div>
          </div>
        </div>
      </div>
    </section>

    <nav class="lv-jump" aria-label={t.jump}>
      <ul class="wrap">{t.jumpLinks.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
    </nav>

    {/* Today */}
    <section id="hom-nay" class="lv-section lv-paper">
      <div class="wrap lv-today">
        <div class="lv-text">
          <p class="lv-kicker">{t.today.kicker}</p>
          <h2>{t.today.title}</h2>
          <p class="lv-body">{t.today.lead}</p>
          <p class="lv-tet-line" data-f="tet">{tetLine}</p>
          <p class="lv-fine">{t.today.note}</p>
        </div>
        <div class="lv-pad">
          <article class="lv-sheet" data-today data-lang={lang} aria-live="polite">
            <span class="lv-tear" aria-hidden="true"></span>
            <header class="lv-sheet-top"><span data-f="month">{solarMonth}</span><span data-f="yearcc">{info.yearCanChi}</span></header>
            <p class="lv-sheet-weekday" data-f="weekday">{t.today.weekdays[info.solar.weekday]}</p>
            <p class="lv-sheet-day" data-f="day">{info.solar.day}</p>
            <div class="lv-sheet-lunar">
              <span>{t.today.lunarLabel}</span>
              <b data-f="lunarday">{info.lunar.day}</b>
              <span data-f="lunarmonth">{lunarMonthName(info.lunar.month, info.lunar.leap)}</span>
            </div>
            <dl class="lv-sheet-cc">
              <div><dt>{t.today.dayLabel}</dt><dd data-f="daycc">{info.dayCanChi}</dd></div>
              <div><dt>{t.today.monthLabel}</dt><dd data-f="monthcc">{info.monthCanChi}</dd></div>
              <div><dt>{t.today.yearLabel}</dt><dd data-f="yearcc2">{info.yearCanChi}</dd></div>
              <div><dt>{t.today.termLabel}</dt><dd data-f="term">{info.solarTerm}</dd></div>
            </dl>
            <h3 class="lv-hours-title">{t.today.hoursLabel}</h3>
            <ul class="lv-hours" data-f="hours">
              {info.goodHours.map((i) => (
                <li><img src={`/assets/apps/lich-viet/chi/${CHI_ICONS[i]}.svg`} width="34" height="33" alt="" loading="lazy" /><b>{CHI[i]}</b><small>{t.today.hourRanges[i]}</small></li>
              ))}
            </ul>
          </article>
        </div>
      </div>
    </section>

    {/* Home styles */}
    <section id="trang-chu" class="lv-section">
      <div class="wrap">
        <div class="lv-head">
          <p class="lv-kicker">{t.homes.kicker} <span class="lv-tag">{t.newTag}</span></p>
          <h2>{t.homes.title}</h2>
          <p class="lv-body">{t.homes.lead}</p>
        </div>
        <ul class="lv-fan">
          {t.homes.styles.map((s) => (
            <li class="lv-fan-item reveal">
              <Pic class="lv-shot" name={shot(s.shot)} alt={alt(s.shot)} sizes="(max-width: 700px) 64vw, 300px" />
              <h3>{s.name}{s.isNew && <span class="lv-tag">{t.newTag}</span>}{s.premium && <span class="lv-tag lv-tag-gold">{t.premiumTag}</span>}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ul>
        <p class="lv-center lv-fine">{t.homes.backgrounds}</p>
      </div>
    </section>

    {/* Family Calendar */}
    <section id="lich-nha" class="lv-section lv-family">
      <div class="lv-family-bg" aria-hidden="true"><Pic name="countryside" alt="" sizes="100vw" /></div>
      <div class="wrap lv-split">
        <div class="lv-text">
          <p class="lv-kicker">{t.family.kicker} <span class="lv-tag">{t.newTag}</span> <span class="lv-tag lv-tag-gold">{t.premiumTag}</span></p>
          <h2>{t.family.title}</h2>
          <p class="lv-body">{t.family.lead}</p>
          <ul class="lv-points">{t.family.points.map((p) => <li>{p}</li>)}</ul>
          <p class="lv-fine">{t.family.note}</p>
        </div>
        <div class="lv-media-center"><Pic class="lv-shot lv-shot-md reveal" name={shot(5)} alt={alt(5)} sizes="(max-width: 820px) 70vw, 320px" /></div>
      </div>
    </section>

    {/* Good days */}
    <section id="ngay-tot" class="lv-section lv-paper">
      <div class="wrap lv-split lv-split-rev">
        <div class="lv-duo-phones">
          <Pic class="lv-shot reveal" name={shot(4)} alt={alt(4)} sizes="(max-width: 820px) 44vw, 270px" />
          <Pic class="lv-shot reveal" name={shot(3)} alt={alt(3)} sizes="(max-width: 820px) 44vw, 270px" />
        </div>
        <div class="lv-text">
          <p class="lv-kicker">{t.goodDays.kicker}</p>
          <h2>{t.goodDays.title}</h2>
          <p class="lv-body">{t.goodDays.lead}</p>
          <ul class="lv-points">{t.goodDays.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      </div>
      <div class="wrap">
        <h3 class="lv-zodiac-title">{t.goodDays.zodiac}</h3>
        <ul class="lv-zodiac">
          {CHI.map((name, i) => (
            <li class:list={[{ 'is-year': i === zodiacYear }]}>
              <img src={`/assets/apps/lich-viet/chi/${CHI_ICONS[i]}.svg`} width="34" height="33" alt="" loading="lazy" />
              <span>{name}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* Culture */}
    <section id="van-hoa" class="lv-section lv-lacquer">
      <span class="lv-drum lv-drum-side" aria-hidden="true"></span>
      <div class="wrap lv-split">
        <div class="lv-text">
          <p class="lv-kicker">{t.culture.kicker}</p>
          <h2>{t.culture.title}</h2>
          <p class="lv-body">{t.culture.lead}</p>
          <ul class="lv-points lv-points-gold">{t.culture.points.map((p) => <li>{p}</li>)}</ul>
        </div>
        <div class="lv-duo-phones">
          <Pic class="lv-shot reveal" name={shot(6)} alt={alt(6)} sizes="(max-width: 820px) 44vw, 270px" />
          <Pic class="lv-shot reveal" name={shot(9)} alt={alt(9)} sizes="(max-width: 820px) 44vw, 270px" />
        </div>
      </div>
    </section>

    {/* Holidays */}
    <section id="tet" class="lv-section lv-red">
      <span class="lv-lotus" aria-hidden="true"></span>
      <div class="wrap lv-split">
        <div class="lv-text">
          <p class="lv-kicker">{t.tet.kicker}</p>
          <h2>{t.tet.title}</h2>
          <p class="lv-body">{t.tet.lead}</p>
          <ul class="lv-points">{t.tet.points.map((p) => <li>{p}</li>)}</ul>
          <p class="lv-tet-badge" data-f="tet">{tetLine}</p>
        </div>
        <div class="lv-duo-phones">
          <Pic class="lv-shot reveal" name={shot(2)} alt={alt(2)} sizes="(max-width: 820px) 44vw, 270px" />
          <Pic class="lv-shot reveal" name={shot(0)} alt={alt(0)} sizes="(max-width: 820px) 44vw, 270px" />
        </div>
      </div>
    </section>

    {/* Widgets */}
    <section id="widget" class="lv-section">
      <div class="wrap lv-split lv-split-rev">
        <div class="lv-duo-phones">
          <Pic class="lv-shot reveal" name={shot(7)} alt={alt(7)} sizes="(max-width: 820px) 44vw, 270px" />
          <Pic class="lv-shot reveal" name={shot(9)} alt={alt(9)} sizes="(max-width: 820px) 44vw, 270px" />
        </div>
        <div class="lv-text">
          <p class="lv-kicker">{t.widgets.kicker} <span class="lv-tag">{t.newTag}</span></p>
          <h2>{t.widgets.title}</h2>
          <p class="lv-body">{t.widgets.lead}</p>
          <ul class="lv-points">{t.widgets.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      </div>
    </section>

    {/* Utilities */}
    <section id="tien-ich" class="lv-section lv-paper">
      <div class="wrap">
        <div class="lv-head">
          <p class="lv-kicker">{t.utilities.kicker}</p>
          <h2>{t.utilities.title}</h2>
        </div>
        <ul class="lv-tools">
          {t.utilities.items.map(([name, text]) => <li class="reveal"><h3>{name}</h3><p>{text}</p></li>)}
        </ul>
        <div class="lv-tools-media">
          <Pic class="lv-shot lv-shot-md reveal" name={shot(8)} alt={alt(8)} sizes="(max-width: 820px) 70vw, 320px" />
        </div>
      </div>
    </section>

    {/* Devices */}
    <section id="thiet-bi" class="lv-section lv-lacquer">
      <div class="wrap">
        <div class="lv-head">
          <p class="lv-kicker">{t.devices.kicker}</p>
          <h2>{t.devices.title}</h2>
        </div>
        <div class="lv-devices">
          <dl class="lv-device-list">
            {t.devices.items.map(([name, text, isNew]) => <div><dt>{name}{isNew && <span class="lv-tag lv-tag-light">{t.newTag}</span>}</dt><dd>{text}</dd></div>)}
          </dl>
        </div>
      </div>
    </section>

    {/* App Store screenshots */}
    <section class="lv-section" aria-labelledby="lv-shots-title">
      <div class="wrap"><h2 id="lv-shots-title" class="lv-shots-title">{t.shotsTitle}</h2></div>
      <div class="lv-shots" tabindex="0" role="group" aria-label={t.shotsTitle}>
        {media.shots.map((name, i) => <Pic name={name} alt={t.shots[i]} sizes="(max-width: 700px) 200px, 260px" />)}
      </div>
    </section>

    {/* FAQ */}
    <section id="hoi-dap" class="lv-section lv-paper">
      <div class="wrap lv-split lv-faq-wrap">
        <h2>{t.faqTitle}</h2>
        <div class="lv-faq">
          {t.faq.map(([q, a]) => (
            <details>
              <summary><h3>{q}</h3></summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="lv-section lv-red lv-cta">
      <span class="lv-drum lv-drum-cta" aria-hidden="true"></span>
      <div class="wrap lv-cta-in">
        <div>
          <h2>{t.ctaTitle}</h2>
          <p class="lv-body">{t.ctaLead}</p>
        </div>
        <StoreBadge href={app.url} lang={lang} tone="white" />
      </div>
    </section>

    <div class="wrap lv-foot">
      <p class="lv-fine">{t.disclaimer}</p>
      {related.length > 0 && (
        <Fragment>
          <h2 class="lv-related">{t.related}</h2>
          <ul class="app-grid">{related.map((a) => <li><AppCard app={a} /></li>)}</ul>
        </Fragment>
      )}
    </div>
  </div>
</Base>

<script>
  import { CHI, CHI_ICONS, LUNAR_MONTHS, dayInfo, vietnamToday } from './lunar';
  import { COPY, MONTHS_EN, type Lang } from './copy';

  // Today's page: recomputed in the browser so it is right even if the build is a day old.
  const sheet = document.querySelector<HTMLElement>('[data-today]');
  if (sheet) {
    const lang = sheet.dataset.lang as Lang;
    const t = COPY[lang].today;
    const fill = (text: string, vars: Record<string, string | number>) => text.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));
    const now = vietnamToday();
    const info = dayInfo(now.day, now.month, now.year);
    const set = (key: string, value: string) => document.querySelectorAll<HTMLElement>(`[data-f="${key}"]`).forEach((el) => { el.textContent = value; });
    const lunarMonth = (lang === 'vi' ? LUNAR_MONTHS[info.lunar.month - 1] : `Month ${info.lunar.month}`) + (info.lunar.leap ? ` (${t.leap})` : '');
    set('month', lang === 'vi' ? fill(t.solarMonth, { m: now.month, y: now.year }) : fill(t.solarMonth, { month: MONTHS_EN[now.month - 1], y: now.year }));
    set('yearcc', info.yearCanChi);
    set('yearcc2', info.yearCanChi);
    set('weekday', t.weekdays[info.solar.weekday]);
    set('day', String(info.solar.day));
    set('lunarday', String(info.lunar.day));
    set('lunarmonth', lunarMonth);
    set('daycc', info.dayCanChi);
    set('monthcc', info.monthCanChi);
    set('term', info.solarTerm);
    set('tet', info.tet.days === 0 ? fill(t.tetToday, { name: info.tet.name }) : fill(t.tet, { n: info.tet.days, name: info.tet.name }));
    const hours = sheet.querySelector('[data-f="hours"]')!;
    hours.replaceChildren(...info.goodHours.map((i) => {
      const li = document.createElement('li');
      const img = Object.assign(document.createElement('img'), { src: `/assets/apps/lich-viet/chi/${CHI_ICONS[i]}.svg`, width: 34, height: 33, alt: '' });
      const name = Object.assign(document.createElement('b'), { textContent: CHI[i] });
      const range = Object.assign(document.createElement('small'), { textContent: t.hourRanges[i] });
      li.append(img, name, range);
      return li;
    }));

    // Tear yesterday's page away once the calendar comes into view. The cover only exists
    // while this script runs, so the page is never hidden if scripts fail.
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      sheet.classList.add('has-tear');
      const observer = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          sheet.classList.add('is-torn');
          observer.disconnect();
        }
      }, { threshold: 0.15 });
      observer.observe(sheet);
    }
  }

</script>

<style>
  .lv {
    --lv-red: #a8231b;
    --lv-red-deep: #7d150f;
    --lv-gold: #d9a441;
    --lv-gold-soft: #ecd29b;
    --lv-lacquer: #17110d;
    --lv-lacquer-2: #251a14;
    --lv-paper: #f3e7cf;
    --lv-paper-2: #ead9b8;
    --lv-ink: #2a1c13;
    --lv-ink-2: #6a5440;
    --lv-serif: 'Alegreya', Georgia, serif;
  }
  .lv h1, .lv h2, .lv h3 { font-family: var(--lv-serif); font-weight: 700; letter-spacing: -.01em; }
  .lv h2 { margin-top: 10px; font-size: clamp(34px, 4.6vw, 60px); line-height: 1.04; }
  .lv-section { position: relative; overflow: hidden; padding-block: clamp(64px, 9vw, 124px); }
  .lv-kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; color: var(--lv-red); font-size: 14px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
  .lv-body { margin-top: 18px; max-width: 34em; color: var(--lv-ink-2); font-size: clamp(17px, 1.4vw, 20px); line-height: 1.55; }
  .lv-fine { margin-top: 18px; max-width: 46em; color: var(--lv-ink-2); font-size: 14px; }
  .lv-center { margin-inline: auto; text-align: center; }
  .lv-head { max-width: 46em; margin-bottom: clamp(36px, 5vw, 64px); }
  .lv-tag { display: inline-flex; align-items: center; min-height: 22px; padding: 0 9px; border-radius: 999px; background: var(--lv-red); color: #fff; font-family: var(--body); font-size: 12px; font-weight: 600; letter-spacing: .02em; text-transform: none; vertical-align: middle; }
  .lv-tag-gold { background: var(--lv-gold); color: var(--lv-lacquer); }
  .lv-tag-light { background: #ffffff26; color: #fff; }
  .lv-points { display: grid; gap: 12px; margin-top: 26px; }
  .lv-points li { position: relative; padding-left: 30px; font-size: 17px; line-height: 1.5; }
  .lv-points li::before { content: ''; position: absolute; left: 4px; top: .45em; width: 12px; height: 12px; border: 2px solid var(--lv-red); transform: rotate(45deg); }
  .lv-split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .lv-split-rev > :first-child { order: 0; }
  @media (max-width: 820px) { .lv-split { grid-template-columns: 1fr; } .lv-split-rev > .lv-text { order: -1; } }
