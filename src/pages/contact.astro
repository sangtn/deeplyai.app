---
import Base from '../layouts/Base.astro';

const NEEDS = '[Tell us what you need here]';
const templates = [
  { topic: 'App support', body: `Hello DeeplyAi team,\n\nI need help with one of your apps.\n\nApp name:\nDevice and iOS version:\nWhat happened:\nWhat I expected:\n\nThank you.` },
  { topic: 'Feature request', body: `Hello DeeplyAi team,\n\nI would like to suggest a feature.\n\nApp name:\nMy idea:\nWhy it would help:\n\nThank you.` },
  { topic: 'Privacy or data request', body: `Hello DeeplyAi team,\n\nI have a question about my data.\n\nApp name:\nMy request:\n\nThank you.` },
  { topic: 'Partnership or project', body: `Hello DeeplyAi team,\n\nI would like to talk about working together.\n\nCompany:\nProject summary:\nTimeline:\n\nThank you.` },
  { topic: 'General question', body: `Hello DeeplyAi team,\n\n${NEEDS}\n\nThank you.` },
];
const mailto = (t: (typeof templates)[number]) =>
  `mailto:info@deeplyai.app?subject=${encodeURIComponent(`[DeeplyAi] ${t.topic}`)}&body=${encodeURIComponent(t.body)}`;
---
<Base path="/contact.html" title="Contact DeeplyAi – Support & App Enquiries" description="Contact DeeplyAi for app support, feature requests or partnership enquiries. Email info@deeplyai.app and we will get back to you.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Contact</p>
      <h1 class="display">Get in touch.</h1>
      <p class="lead">Suggest a feature, report an issue, or tell us about a project. Pick a topic and we will start the message for you.</p>
    </header>
    <section class="section split" style="padding-top:24px">
      <div>
        <dl class="contact-list">
          <div><dt>Email</dt><dd><a href="mailto:info@deeplyai.app">info@deeplyai.app</a></dd></div>
          <div><dt>Phone</dt><dd><a href="tel:+840352053998">+84 035 2053 998</a></dd></div>
          <div><dt>Office</dt><dd>Mai Dich, Ha Noi, Vietnam</dd></div>
        </dl>
      </div>
      <form class="form" action="mailto:info@deeplyai.app" method="post" enctype="text/plain" data-contact>
        <label>Your name<input name="name" autocomplete="name" required maxlength="200" /></label>
        <label>Email address<input name="email" type="email" autocomplete="email" required maxlength="200" /></label>
        <label>Topic
          <select name="topic" data-topic>
            {templates.map((t) => <option value={t.topic} data-body={t.body}>{t.topic}</option>)}
          </select>
        </label>
        <label>Message<textarea name="message" rows="10" required maxlength="2000" data-message>{templates[0].body}</textarea></label>
        <div class="actions"><button class="btn" type="submit" style="cursor:pointer">Open email to send</button></div>
        <p style="color:var(--ink-2);font-size:14px">This opens your email app with the message filled in, ready for you to send. See our <a href="/privacy.html">Privacy Policy</a>.</p>
      </form>
    </section>
    <section class="section" style="padding-top:0" aria-labelledby="ready-title">
      <h2 id="ready-title" class="h-lg" style="margin-bottom:12px">Ready-made emails</h2>
      <p class="lead" style="margin-bottom:28px">Prefer your own email app? Pick one and the message opens already written.</p>
      <ul class="app-grid">
        {templates.map((t) => <li><a class="app-card" href={mailto(t)}><div><strong>{t.topic}</strong><span>{t.body.split('\n')[2]}</span></div></a></li>)}
      </ul>
    </section>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('form[data-contact]');
  if (form) {
    const topic = form.querySelector<HTMLSelectElement>('[data-topic]')!;
    const message = form.querySelector<HTMLTextAreaElement>('[data-message]')!;
    const templateFor = () => topic.selectedOptions[0].dataset.body ?? '';
    let untouched = true;

    // Browsers may restore a previous selection, so the text always follows the chosen topic.
    message.value = templateFor();
    message.addEventListener('input', () => { untouched = message.value === templateFor(); });
    topic.addEventListener('change', () => {
      if (untouched) message.value = templateFor();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const value = (key: string) => String(data.get(key) ?? '').trim();
      const body = [`Name: ${value('name')}`, `Email: ${value('email')}`, '', value('message')].join('\n');
      const subject = `[DeeplyAi] ${value('topic')}`;
      window.location.href = `mailto:info@deeplyai.app?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
