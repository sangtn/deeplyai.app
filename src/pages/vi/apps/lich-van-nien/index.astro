---
import Base from '../../../../layouts/Base.astro';
import StoreBadge from '../../../../components/StoreBadge.astro';
import { byId, hasRating } from '../../../../data/catalog';

const app = byId.get(6749473194)!;
const site = 'https://deeplyai.app';
const path = '/vi/apps/lich-van-nien/';
const showRating = hasRating(app);
const description = 'Lịch Vạn Niên là ứng dụng lịch âm Việt Nam cho iPhone, iPad, Apple Watch và CarPlay, có giờ Hoàng Đạo, sự kiện âm lịch và kinh Phật.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Lịch Vạn Niên',
    description,
    inLanguage: 'vi',
    url: `${site}${path}`,
    image: `${site}${app.iconLarge}`,
    screenshot: app.screenshots.map((s) => `${site}${s}`),
    operatingSystem: `iOS ${app.minimumOs} or later`,
    applicationCategory: `${app.genre}Application`,
    softwareVersion: app.version,
    installUrl: app.url,
    author: { '@type': 'Organization', name: 'DeeplyAi', url: `${site}/` },
    offers: { '@type': 'Offer', price: app.price, priceCurrency: 'USD' },
    ...(showRating && { aggregateRating: { '@type': 'AggregateRating', ratingValue: app.rating, ratingCount: app.ratingCount, bestRating: 5, worstRating: 1 } }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: `${site}/vi/` },
      { '@type': 'ListItem', position: 2, name: 'Ứng dụng', item: `${site}/vi/apps/` },
      { '@type': 'ListItem', position: 3, name: 'Lịch Vạn Niên', item: `${site}${path}` },
    ],
  },
];
---
<Base lang="vi" path={path} alternates={{ en: '/apps/lich-van-nien/', vi: path }} jsonLd={jsonLd} title="Lịch Vạn Niên – Ứng dụng lịch âm Việt Nam | DeeplyAi" description={description}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Đường dẫn"><a href="/vi/apps/">Ứng dụng</a><span>/</span><span>Lịch Vạn Niên</span></nav>
    <header class="app-hero">
      <img src={app.iconLarge} width="176" height="176" alt="Biểu tượng ứng dụng Lịch Vạn Niên" />
      <div>
        <h1>Lịch Vạn Niên</h1>
        <p class="lead">Lịch âm Việt Nam đồng bộ trên mọi thiết bị Apple của bạn.</p>
        <p class="app-meta">
          {showRating && <span>{app.rating.toFixed(1)}/5 từ {app.ratingCount} đánh giá</span>}
          <span>Yêu cầu iOS {app.minimumOs} trở lên</span>
          <span>Phiên bản {app.version}</span>
        </p>
        <div class="actions"><StoreBadge href={app.url} lang="vi" /></div>
      </div>
    </header>
  </div>
  <div class="shots" tabindex="0" role="group" aria-label="Ảnh chụp màn hình Lịch Vạn Niên">
    {app.screenshots.map((src, i) => <img src={src} width="392" height="850" alt={`Ảnh chụp màn hình Lịch Vạn Niên ${i + 1}`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />)}
  </div>
  <div class="wrap section" style="padding-top:48px">
    <article class="prose">
      <h2>Xem ngày âm ở bất cứ đâu</h2>
      <p>Lịch Vạn Niên chuyển đổi chính xác giữa lịch âm Việt Nam và lịch dương, hoạt động mượt mà trên iPhone, iPad, Apple Watch và CarPlay.</p>
      <h2>Dành cho những ngày quan trọng của gia đình</h2>
      <ul>
        <li>Xem giờ và ngày <strong>Hoàng Đạo</strong>, tránh <strong>Hắc Đạo</strong> khi chọn thời điểm cho việc lớn.</li>
        <li>Lên kế hoạch cưới hỏi, giỗ chạp và các dịp kỷ niệm với giờ, ngày, tháng, năm âm lịch, được phân loại rõ ràng.</li>
        <li>Đếm số ngày giữa hai mốc thời gian, kể cả khi một mốc là ngày âm và mốc kia là ngày dương.</li>
      </ul>
      <h2>Khoảnh khắc tĩnh tại</h2>
      <p>Trình phát âm thanh tích hợp có thư viện kinh Phật được chọn lọc, giúp bạn thư thái và thực hành chánh niệm.</p>
    </article>
  </div>
</Base>
