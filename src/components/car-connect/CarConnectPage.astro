---
// Marketing page for Car Connect (App Store id 6755303976), EN at /apps/car-play-connect/
// and VI at /vi/apps/car-play-connect/. The URL keeps its old slug for existing backlinks;
// the app's name is "Car Connect".
import Base from '../../layouts/Base.astro';
import StoreBadge from '../StoreBadge.astro';
import AppCard from '../AppCard.astro';
import Pic from './Pic.astro';
import Clip from './Clip.astro';
import media from '../../data/car-connect-media.json';
import { COPY, LANGUAGES, type Lang } from './copy';
import { GROUPS, byId, hasRating, inGroup } from '../../data/catalog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const vi = lang === 'vi';
const t = COPY[lang];

const ID = 6755303976;
const app = byId.get(ID)!;
const site = 'https://deeplyai.app';
const paths = { en: '/apps/car-play-connect/', vi: '/vi/apps/car-play-connect/' };
const path = paths[lang];
const url = `${site}${path}`;
const showRating = hasRating(app);
const rating = vi ? app.rating.toFixed(1).replace('.', ',') : app.rating.toFixed(1);
const group = GROUPS[app.group];
const related = inGroup(app.group).filter((a) => a.id !== ID).slice(0, 3);
const shotsAbs = media.shots.map((s) => `${site}/assets/apps/car-connect/${s}-560.jpg`);
const feature = (id: string) => t.features.find((f) => f.id === id)!;
const tour = media.videos['drive-tour'];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    '@id': `${site}/apps/car-play-connect/#app`,
    name: 'Car Connect',
    alternateName: 'Car Connect: Driving Dashboard',
    description: t.description,
    url,
    inLanguage: lang,
    image: `${site}${app.iconLarge}`,
    screenshot: shotsAbs,
    operatingSystem: `iOS ${app.minimumOs} or later`,
    applicationCategory: 'TravelApplication',
    applicationSubCategory: 'Navigation',
    availableOnDevice: 'iPhone, iPad',
    softwareVersion: app.version,
    installUrl: app.url,
    downloadUrl: app.url,
    featureList: t.features.map((f) => f.kicker).concat(t.carplay.kicker, t.compat.title),
    author: { '@type': 'Organization', name: 'DeeplyAi', url: `${site}/` },
    publisher: { '@type': 'Organization', name: 'DeeplyAi', url: `${site}/` },
    offers: {
      '@type': 'Offer',
      price: 0,
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: app.url,
      description: vi ? 'Tải miễn phí. Có mua trong ứng dụng: gói đăng ký Premium tuỳ chọn.' : 'Free download. Offers in-app purchases: an optional Premium subscription.',
    },
    ...(showRating && { aggregateRating: { '@type': 'AggregateRating', ratingValue: app.rating, ratingCount: app.ratingCount, bestRating: 5, worstRating: 1 } }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: vi ? 'Chế độ lái xe của Car Connect' : 'Car Connect Driving Mode tour',
    description: t.heroVideo,
    thumbnailUrl: `${site}/assets/apps/car-connect/drive-tour-poster.jpg`,
    contentUrl: `${site}/assets/apps/car-connect/drive-tour.mp4`,
    uploadDate: '2026-11-11',
    duration: `PT${Math.round(tour.duration)}S`,
    inLanguage: lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: t.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: (vi
      ? [[t.crumbs[0], '/vi/'], [t.crumbs[1], '/vi/apps/'], [t.crumbs[2], path]]
      : [[t.crumbs[0], '/'], [t.crumbs[1], '/apps/'], [group.name, `/apps/${app.group}/`], [t.crumbs[2], path]]
    ).map(([name, p], i) => ({ '@type': 'ListItem', position: i + 1, name, item: `${site}${p}` })),
  },
];
---
<Base
  lang={lang}
  path={path}
  alternates={paths}
  title={t.title}
  description={t.description}
  ogImage={`/assets/apps/car-connect/og-${lang}.jpg`}
  ogImageAlt={t.ogAlt}
  jsonLd={jsonLd}
>
  <link slot="head" rel="preload" as="image" type="image/avif" href="/assets/apps/car-connect/drive-tour-poster.avif" fetchpriority="high" />

  <div class="cc">
    <section class="cc-hero">
      <div class="wrap">
        <nav class="crumbs" aria-label={vi ? 'Đường dẫn' : 'Breadcrumb'}>
          {vi
            ? <Fragment><a href="/vi/apps/">{t.crumbs[1]}</a><span>/</span><span aria-current="page">Car Connect</span></Fragment>
            : <Fragment><a href="/apps/">Apps</a><span>/</span><a href={`/apps/${app.group}/`}>{group.name}</a><span>/</span><span aria-current="page">Car Connect</span></Fragment>}
        </nav>
        <div class="cc-hero-grid">
          <div class="cc-hero-copy">
            <img class="cc-icon" src={app.iconLarge} width="112" height="112" alt={vi ? 'Biểu tượng ứng dụng Car Connect' : 'Car Connect app icon'} style={`view-transition-name:app-${ID}`} />
            <p class="eyebrow">{t.eyebrow}</p>
            <h1>{t.h1}<span class="sr-only">: </span><span class="cc-h1-sub">{t.h1Sub}</span></h1>
            <p class="lead">{t.lead}</p>
            <div class="actions">
              <StoreBadge href={app.url} lang={lang} tone="white" />
              <a class="btn ghost" href="#compatibility">{t.compatLink}</a>
            </div>
            <p class="app-meta">
              {showRating && <span>{t.ratingLine(rating, app.ratingCount)}</span>}
              <span>{t.free}</span>
              <span>{t.requires(app.minimumOs)}</span>
            </p>
          </div>
          <div class="cc-hero-media">
            <div class="cc-device cc-landscape">
              <Clip name="drive-tour" label={t.heroVideo} lang={lang} eager />
            </div>
          </div>
        </div>
      </div>
    </section>

    <nav class="cc-jump" aria-label={t.jump}>
      <ul class="wrap">
        {t.jumpLinks.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
      </ul>
    </nav>

    <section class="wrap cc-new" aria-labelledby="cc-new-title">
      <h2 id="cc-new-title" class="surface-label">{t.whatsNewKicker}</h2>
      <ul class="cc-tags">{t.whatsNew.map((item) => <li>{item}</li>)}</ul>
    </section>

    <section aria-labelledby="cc-shots-title">
      <h2 id="cc-shots-title" class="wrap surface-label">{t.shotsTitle}</h2>
      <div class="shots cc-shots" tabindex="0" role="group" aria-label={t.shotsTitle}>
        {media.shots.map((name, i) => <Pic name={name} alt={t.shots[i]} sizes="(max-width: 700px) 200px, 280px" />)}
      </div>
    </section>

    {/* Driving Mode */}
    <section id="driving-mode" class="cc-feature wrap">
      <div class="cc-text">
        <p class="eyebrow">{feature('driving-mode').kicker}</p>
        <h2 class="h-lg">{feature('driving-mode').title}</h2>
        <p class="lead">{feature('driving-mode').lead}</p>
        <ul class="cc-points">{feature('driving-mode').points.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div class="cc-gallery">
        {t.driveCaptions.map(([name, caption]) => (
          <figure class="reveal">
            <div class="cc-device cc-landscape"><Pic name={name} alt={caption} sizes="(max-width: 820px) 92vw, 34vw" /></div>
            <figcaption>{caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    {/* Speedometer & HUD */}
    <section id="speedometer" class="cc-feature cc-night">
      <div class="wrap cc-split">
        <div class="cc-media cc-media-pair">
          <div class="cc-device cc-portrait reveal"><Clip name="speed" label={t.alts.speed} lang={lang} /></div>
          <div class="cc-device cc-landscape reveal"><Pic name="dm-hud" alt={t.alts.hud} sizes="(max-width: 820px) 92vw, 40vw" /></div>
        </div>
        <div class="cc-text">
          <p class="eyebrow">{feature('speedometer').kicker}</p>
          <h2 class="h-lg">{feature('speedometer').title}</h2>
          <p class="lead">{feature('speedometer').lead}</p>
          <ul class="cc-points">{feature('speedometer').points.map((p) => <li>{p}</li>)}</ul>
        </div>
      </div>
    </section>

    {/* Radio */}
    <section id="radio" class="cc-feature wrap cc-split">
      <div class="cc-text">
        <p class="eyebrow">{feature('radio').kicker}</p>
        <h2 class="h-lg">{feature('radio').title}</h2>
        <p class="lead">{feature('radio').lead}</p>
        <ul class="cc-points">{feature('radio').points.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div class="cc-media cc-media-pair cc-media-pair-rev">
        <div class="cc-device cc-landscape reveal"><Pic name="dm-radio" alt={t.alts.radio} sizes="(max-width: 820px) 92vw, 40vw" /></div>
        <div class="cc-device cc-portrait reveal"><Pic name="radio-player" alt={t.alts.radioPlayer} sizes="(max-width: 820px) 46vw, 220px" /></div>
      </div>
    </section>

    {/* Trips */}
    <section id="trips" class="cc-feature cc-tint">
      <div class="wrap cc-split">
        <div class="cc-media">
          <div class="cc-device cc-portrait reveal"><Pic name="history" alt={t.alts.history} sizes="(max-width: 820px) 70vw, 300px" /></div>
        </div>
        <div class="cc-text">
          <p class="eyebrow">{feature('trips').kicker}</p>
          <h2 class="h-lg">{feature('trips').title}</h2>
          <p class="lead">{feature('trips').lead}</p>
          <ul class="cc-points">{feature('trips').points.map((p) => <li>{p}</li>)}</ul>
          <p class="note">{feature('trips').note}</p>
        </div>
      </div>
    </section>

    {/* Dash cam */}
    <section id="dash-cam" class="cc-feature wrap cc-split">
      <div class="cc-text">
        <p class="eyebrow">{feature('dash-cam').kicker}</p>
        <h2 class="h-lg">{feature('dash-cam').title}</h2>
        <p class="lead">{feature('dash-cam').lead}</p>
        <ul class="cc-points">{feature('dash-cam').points.map((p) => <li>{p}</li>)}</ul>
        <p class="note">{feature('dash-cam').note}</p>
      </div>
      <div class="cc-media">
        <div class="cc-device cc-landscape reveal"><Pic name="dm-dashcam" alt={t.alts.dashcam} sizes="(max-width: 820px) 92vw, 50vw" /></div>
      </div>
    </section>

    {/* Nearby + Trip Weather */}
    <section class="cc-night cc-feature">
      <div class="wrap cc-duo">
        {(['nearby', 'weather'] as const).map((id) => (
          <article id={id} class="cc-card">
            <div class="cc-device cc-portrait reveal"><Clip name={id} label={t.alts[id]} lang={lang} /></div>
            <div>
              <p class="eyebrow">{feature(id).kicker}</p>
              <h2>{feature(id).title}</h2>
              <p class="cc-card-lead">{feature(id).lead}</p>
              <ul class="cc-points">{feature(id).points.map((p) => <li>{p}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* Garage */}
    <section id="garage" class="cc-feature wrap cc-split">
      <div class="cc-media cc-phones">
        <div class="cc-device cc-portrait reveal"><Pic name="garage" alt={t.alts.garage} sizes="(max-width: 820px) 44vw, 260px" /></div>
        <div class="cc-device cc-portrait reveal"><Pic name="home" alt={t.alts.home} sizes="(max-width: 820px) 44vw, 260px" /></div>
      </div>
      <div class="cc-text">
        <p class="eyebrow">{feature('garage').kicker}</p>
        <h2 class="h-lg">{feature('garage').title}</h2>
        <p class="lead">{feature('garage').lead}</p>
        <ul class="cc-points">{feature('garage').points.map((p) => <li>{p}</li>)}</ul>
        <p class="note">{feature('garage').note}</p>
      </div>
    </section>

    {/* CarPlay */}
    <section id="carplay" class="cc-feature cc-tint">
      <div class="wrap cc-split">
        <div class="cc-text">
          <p class="eyebrow">{t.carplay.kicker}</p>
          <h2 class="h-lg">{t.carplay.title}</h2>
          <p class="lead">{t.carplay.lead}</p>
        </div>
        <div>
          <ul class="cc-checks">{t.carplay.points.map((p) => <li>{p}</li>)}</ul>
          <p class="note">{t.carplay.note}</p>
        </div>
      </div>
    </section>

    {/* Compatibility */}
    <section id="compatibility" class="cc-feature wrap">
      <div class="cc-head">
        <p class="eyebrow">{t.compat.kicker}</p>
        <h2 class="h-lg">{t.compat.title}</h2>
        <p class="lead">{t.compat.lead}</p>
      </div>
      <ul class="cc-compat">
        {t.compat.cards.map((c) => (
          <li class="reveal">
            <span class={`cc-status cc-${c.tone}`}>{c.status}</span>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </li>
        ))}
      </ul>
      <p class="note cc-howto">{t.compat.howTo}</p>
    </section>

    {/* Devices */}
    <section class="cc-feature cc-night" aria-labelledby="cc-devices-title">
      <div class="wrap">
        <div class="cc-head">
          <p class="eyebrow">{t.devices.kicker}</p>
          <h2 id="cc-devices-title" class="h-lg">{t.devices.title}</h2>
        </div>
        <div class="cc-devices">
          <figure class="cc-ipad reveal">
            <div class="cc-device cc-tablet"><Pic name="ipad-dm" alt={t.alts.ipad} sizes="(max-width: 820px) 92vw, 52vw" /></div>
          </figure>
          <figure class="cc-duo-shot reveal">
            <div class="cc-device cc-fold"><Pic name="duo-home" alt={t.alts.duo} sizes="(max-width: 820px) 60vw, 300px" /></div>
          </figure>
          <dl class="cc-device-list">
            {t.devices.items.map(([name, text]) => <div><dt>{name}</dt><dd>{text}</dd></div>)}
          </dl>
        </div>
        <h3 class="cc-lang-title">{t.devices.languages}</h3>
        <ul class="cc-tags cc-tags-night">{LANGUAGES.map((l) => <li>{l}</li>)}</ul>
      </div>
    </section>

    {/* Privacy */}
    <section id="privacy" class="cc-feature wrap">
      <div class="cc-head">
        <p class="eyebrow">{t.privacy.kicker}</p>
        <h2 class="h-lg">{t.privacy.title}</h2>
        <p class="lead">{t.privacy.lead}</p>
      </div>
      <div class="steps cc-privacy">
        {t.privacy.items.map(([name, text]) => <div class="step reveal"><b>{name}</b><p>{text}</p></div>)}
      </div>
      <p><a class="cc-link" href="/privacy.html">{t.privacy.link}</a></p>
    </section>

    {/* Premium */}
    <section id="premium" class="cc-feature cc-tint">
      <div class="wrap cc-split">
        <div class="cc-text">
          <p class="eyebrow">{t.premium.kicker}</p>
          <h2 class="h-lg">{t.premium.title}</h2>
          <p class="lead">{t.premium.lead}</p>
        </div>
        <div>
          <table class="cc-table">
            <caption class="sr-only">{t.premium.kicker}</caption>
            <thead><tr>{t.premium.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>
              {t.premium.rows.map(([name, free, premium]) => (
                <tr><th scope="row">{name}</th><td>{free}</td><td class="cc-premium">{premium}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="cc-fine">{t.premium.fine} <a href="/terms.html">{t.premium.terms}</a> · <a href="/privacy.html">{t.premium.policy}</a></p>
        </div>
      </div>
    </section>

    {/* FAQ */}
    <section id="faq" class="cc-feature wrap cc-split">
      <h2 class="h-lg">{t.faqTitle}</h2>
      <div class="cc-faq">
        {t.faq.map(([q, a]) => (
          <details>
            <summary><h3>{q}</h3></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="band section">
      <div class="wrap band-in">
        <div>
          <h2 class="h-lg" style="max-width:11em">{t.ctaTitle}</h2>
          <p class="lead" style="margin-top:16px">{t.ctaLead}</p>
        </div>
        <StoreBadge href={app.url} lang={lang} tone="white" />
      </div>
    </section>

    <div class="wrap cc-foot">
      <p class="cc-fine">{t.disclaimer}</p>
      {related.length > 0 && (
        <Fragment>
          <h2 class="h-lg cc-related">{t.related}</h2>
          <ul class="app-grid">{related.map((a) => <li><AppCard app={a} /></li>)}</ul>
        </Fragment>
      )}
    </div>
  </div>
</Base>

<script>
  // Start each clip only when it is on screen, after the page has loaded, and never for
  // people who prefer reduced motion. Sources are attached lazily so videos cost nothing
  // until they are needed.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const clips = [...document.querySelectorAll<HTMLVideoElement>('video[data-clip]')];

  const load = (video: HTMLVideoElement) => {
    if (video.dataset.loaded) return;
    video.dataset.loaded = '1';
    video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => { s.src = s.dataset.src!; });
    video.load();
    video.addEventListener('playing', () => video.parentElement!.classList.add('is-playing'), { once: true });
  };

  const setup = () => {
    if (reduce.matches || !('IntersectionObserver' in window)) return;
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (video.dataset.paused) continue;
        if (entry.isIntersecting) { load(video); video.play().catch(() => {}); }
        else video.pause();
      }
    }, { rootMargin: '200px 0px', threshold: 0.25 });
    clips.forEach((video) => {
      observer.observe(video);
      const button = video.parentElement!.querySelector<HTMLButtonElement>('.clip-toggle');
      if (!button) return;
      button.hidden = false;
      button.addEventListener('click', () => {
        const pausing = !video.paused;
        if (pausing) { video.pause(); video.dataset.paused = '1'; }
        else { delete video.dataset.paused; load(video); video.play().catch(() => {}); }
        button.setAttribute('aria-label', pausing ? button.dataset.play! : button.dataset.pause!);
        button.classList.toggle('is-paused', pausing);
      });
    });
  };

  if (document.readyState === 'complete') setup();
  else addEventListener('load', setup, { once: true });
</script>

<style>
  .cc { --cc-night: var(--night); --cc-green: #34c759; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Hero */
  .cc-hero { background: var(--night); color: var(--on-night); padding-bottom: clamp(48px, 7vw, 96px); overflow: hidden; }
  .cc-hero .crumbs { color: var(--on-night-2); }
  .cc-hero .crumbs a:hover { color: #ff8a62; }
  .cc-hero-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr); gap: clamp(32px, 5vw, 72px); align-items: center; padding-top: clamp(24px, 3vw, 40px); }
  .cc-icon { width: clamp(64px, 6vw, 84px); height: auto; border-radius: 22.5%; box-shadow: 0 12px 30px #0007; margin-bottom: 18px; }
  .cc-hero .eyebrow { color: #ff8a62; }
  .cc-hero h1 { margin-top: 10px; font-size: clamp(46px, 5.6vw, 84px); }
  .cc-hero h1 .cc-h1-sub { display: block; margin-top: 10px; font-size: clamp(22px, 2.3vw, 32px); font-weight: 600; line-height: 1.15; letter-spacing: -.01em; color: var(--on-night-2); }
  .cc-hero .lead { margin-top: 20px; color: var(--on-night-2); }
  .cc-hero .actions { align-items: center; margin-top: 28px; }
  .cc-hero .btn.ghost { border-color: #f3efe666; color: var(--on-night); }
  .cc-hero .btn.ghost:hover { background: var(--on-night); color: var(--ink); }
  .cc-hero .app-meta { color: var(--on-night-2); margin-top: 22px; }
  .cc-hero-media { position: relative; }
  .cc-hero-media::before { content: ''; position: absolute; inset: 10% -20% -30% 10%; background: radial-gradient(closest-side, #c8360b55, transparent); pointer-events: none; }
  @media (max-width: 900px) { .cc-hero-grid { grid-template-columns: 1fr; } }

  /* Device frames */
  .cc-device { position: relative; overflow: hidden; background: #000; border: 8px solid #2d2e27; box-shadow: 0 22px 50px #15140f40; }
  .cc-device :global(picture), .cc-device :global(img), .cc-device :global(video) { display: block; width: 100%; height: auto; }
  .cc-landscape { border-radius: 34px; }
  .cc-portrait { border-radius: 38px; max-width: 300px; }
  .cc-tablet { border-width: 12px; border-radius: 30px; }
  .cc-fold { border-radius: 30px; max-width: 300px; }
  @media (max-width: 620px) { .cc-device { border-width: 6px; } .cc-landscape { border-radius: 22px; } .cc-portrait { border-radius: 30px; } }

  /* Clips: video fades in over its poster once it actually plays */
  .cc-device :global(.clip) { position: relative; width: 100%; }
  .cc-device :global(.clip picture), .cc-device :global(.clip img) { width: 100%; height: 100%; }
  .cc-device :global(.clip video) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .4s; }
  .cc-device :global(.clip.is-playing video) { opacity: 1; }
  .cc-device :global(.clip-toggle) { position: absolute; right: 10px; bottom: 10px; z-index: 2; display: grid; place-items: center; width: 36px; height: 36px; padding: 0; border: 0; border-radius: 50%; background: #000a; color: #fff; cursor: pointer; opacity: .75; }
  .cc-device :global(.clip-toggle:hover), .cc-device :global(.clip-toggle:focus-visible) { opacity: 1; }
  .cc-device :global(.clip-toggle span) { width: 10px; height: 12px; border-inline: 3px solid currentColor; }
  .cc-device :global(.clip-toggle.is-paused span) { width: 0; height: 0; border: 0; border-left: 11px solid currentColor; border-block: 7px solid transparent; margin-left: 3px; }

  /* Jump links */
