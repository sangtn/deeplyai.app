---
import { CHI, LUNAR_MONTHS, dayInfo, vietnamToday } from './lich-viet/lunar';
import { byId } from '../data/catalog';

interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const vi = lang === 'vi';

// The Web card shows a live piece of Lịch Vạn Niên: today's lunar date, computed at build
// time and recomputed in the browser so it never shows yesterday.
const lich = byId.get(6749473194);
const today = vietnamToday();
const info = dayInfo(today.day, today.month, today.year);
const lunarDate = (d: number, m: number, leap: boolean) => (vi ? `${d} ${LUNAR_MONTHS[m - 1]}` : `Month ${m}, day ${d}`) + (leap ? (vi ? ' (nhuận)' : ' (leap)') : '');
const lichHref = vi ? '/vi/lich-am/' : '/apps/lich-van-nien/#hom-nay';
const GLOBALSDR_URL = 'https://play.google.com/store/apps/details?id=com.orientpro.globalsdr';
---
<section class="roadmap" aria-labelledby="roadmap-title">
  <div class="wrap">
    <p class="eyebrow">{vi ? 'Ngoài App Store' : 'Beyond the App Store'}</p>
    <h2 id="roadmap-title" class="h-lg">{vi ? 'Vượt ra ngoài hệ sinh thái Apple.' : 'Beyond the Apple ecosystem.'}</h2>
    <p class="lead">{vi ? 'Ứng dụng DeeplyAi giờ đã có trên Android và web, để nhiều người hơn có thể sử dụng.' : 'DeeplyAi apps now reach Android and the web, so more people can use them.'}</p>
    <div class="roadmap-grid">
      <article class="road road-live">
        <span class="status status-live"><i aria-hidden="true"></i>{vi ? 'Đã có trên Google Play' : 'Now on Google Play'}</span>
        <h3>Android</h3>
        <p>{vi ? 'Ứng dụng Android đầu tiên của chúng tôi: nghe radio sóng ngắn, ham và hàng không trực tiếp từ hơn 1.300 máy thu thật trên khắp thế giới.' : 'Our first Android app: live shortwave, ham and aviation radio from more than 1,300 real receivers around the world.'}</p>
        <a class="web-tile" href={GLOBALSDR_URL} rel="noopener">
          <img src="/assets/images/android/globalsdr.png" width="52" height="52" alt="" loading="lazy" decoding="async" />
          <span class="web-tile-body">
            <small>{vi ? 'Ứng dụng Android' : 'Android app'}</small>
            <b>Shortwave SDR Radio: GlobalSDR</b>
            <span class="web-tile-cc">{vi ? 'Biết đài nào đang phát, xem phổ và thác nước tín hiệu, theo dõi điều kiện truyền sóng. Có widget và Wear OS.' : 'See which station is on air, tune on a live waterfall and check band conditions. Widgets and Wear OS included.'}</span>
          </span>
          <span class="web-tile-go">{vi ? 'Xem trên Google Play' : 'View on Google Play'} <span aria-hidden="true">→</span></span>
        </a>
        <a class="gp-link" href={GLOBALSDR_URL} rel="noopener">
          <img class="gp-badge" src={`/assets/images/stores/google-play-badge-${vi ? 'vi' : 'en'}.png`} width="564" height="168" loading="lazy" alt={vi ? 'Tải GlobalSDR trên Google Play' : 'Get GlobalSDR on Google Play'} />
        </a>
        <p class="web-next">{vi ? 'Tiếp theo: thêm nhiều ứng dụng DeeplyAi cho Android.' : 'Next: more DeeplyAi apps for Android.'}</p>
      </article>
      <article class="road road-live">
        <span class="status status-live"><i aria-hidden="true"></i>{vi ? 'Đã có bản đầu tiên' : 'First one is live'}</span>
        <h3>Web</h3>
        <p>{vi ? 'Trải nghiệm ngay trên trình duyệt, không cần cài đặt. Bắt đầu với lịch âm của Lịch Vạn Niên.' : 'Experiences that open right in your browser, with nothing to install. It starts with the lunar calendar from Lịch Vạn Niên.'}</p>
        <a class="web-tile" href={lichHref} data-rm-today>
          {lich && <img src={lich.icon} width="52" height="52" alt="" loading="lazy" decoding="async" />}
          <span class="web-tile-body">
            <small>{vi ? 'Âm lịch hôm nay' : 'Lunar date today'}</small>
            <b data-rm="date">{lunarDate(info.lunar.day, info.lunar.month, info.lunar.leap)}</b>
            <span class="web-tile-cc">{vi ? 'Ngày' : 'Day'} <span data-rm="daycc">{info.dayCanChi}</span> · {vi ? 'Năm' : 'Year'} <span data-rm="yearcc">{info.yearCanChi}</span></span>
            <span class="web-tile-cc">{vi ? 'Giờ Hoàng Đạo' : 'Auspicious hours'}: <span data-rm="hours">{info.goodHours.map((i) => CHI[i]).join(', ')}</span></span>
          </span>
          <span class="web-tile-go">{vi ? 'Mở trên web' : 'Open on the web'} <span aria-hidden="true">→</span></span>
        </a>
        <p class="web-next">{vi ? 'Tiếp theo: các công cụ web nhỏ cho những ứng dụng khác.' : 'Next: small web tools for more of our apps.'}</p>
      </article>
    </div>
    <p class="fine">{vi ? 'Trên Google Play hiện có GlobalSDR; trên web, hiện có lịch âm của Lịch Vạn Niên. Các kế hoạch tiếp theo có thể thay đổi về phạm vi và thời gian.' : 'GlobalSDR is live on Google Play, and the Lịch Vạn Niên lunar calendar is live on the web. Further plans may change in scope and timing.'}</p>
  </div>
</section>

<script>
  import { CHI, LUNAR_MONTHS, dayInfo, vietnamToday } from './lich-viet/lunar';

  const tile = document.querySelector<HTMLElement>('[data-rm-today]');
  if (tile) {
    const vi = document.documentElement.lang.startsWith('vi');
    const now = vietnamToday();
    const info = dayInfo(now.day, now.month, now.year);
    const set = (key: string, value: string) => { const el = tile.querySelector(`[data-rm="${key}"]`); if (el) el.textContent = value; };
    const { day, month, leap } = info.lunar;
    set('date', (vi ? `${day} ${LUNAR_MONTHS[month - 1]}` : `Month ${month}, day ${day}`) + (leap ? (vi ? ' (nhuận)' : ' (leap)') : ''));
    set('daycc', info.dayCanChi);
    set('yearcc', info.yearCanChi);
    set('hours', info.goodHours.map((i) => CHI[i]).join(', '));
  }
</script>
